{
  "name": "international-life-android",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "International Life: tiny Android launcher that downloads / updates the game from a link (Cloudflare Pages).",
  "scripts": {
    "postinstall": "node scripts/install-game.mjs",
    "update": "node scripts/make-update.mjs --deploy",
    "update:build": "node scripts/make-update.mjs",
    "apk": "node scripts/build-apk.mjs",
    "launcher:build": "vite build",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/network": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  },
  "engines": { "node": ">=20.12" }
}
